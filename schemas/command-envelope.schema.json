{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtg-commander-sim.local/schemas/command-envelope-v3.0.json",
  "title": "Quorune client command envelope v3.0",
  "description": "The authenticated principal is transport metadata and MUST NOT be accepted from this client-controlled body.",
  "type": "object",
  "required": [
    "protocol_version",
    "game_id",
    "command_id",
    "decision_id",
    "action_id",
    "capability",
    "expected_view_revision",
    "choices"
  ],
  "properties": {
    "protocol_version": {"const": "3.0"},
    "game_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "command_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "decision_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "action_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "capability": {"type": "string", "minLength": 32, "maxLength": 256},
    "expected_view_revision": {"type": "integer", "minimum": 0},
    "choices": {"type": "object"}
  },
  "additionalProperties": false
}
