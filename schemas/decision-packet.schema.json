{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtg-commander-sim.local/schemas/decision-packet-v3.0.json",
  "title": "Quorune projected decision packet v3.0",
  "type": "object",
  "required": [
    "v",
    "mode",
    "principal",
    "pkt",
    "base",
    "view",
    "view_revision",
    "decision"
  ],
  "properties": {
    "v": {"const": "3.0"},
    "mode": {"enum": ["full", "delta"]},
    "principal": {"type": "string", "minLength": 1},
    "pkt": {"type": "integer", "minimum": 1},
    "base": {"type": ["string", "null"]},
    "view": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
    "view_revision": {"type": "integer", "minimum": 0},
    "rev": {"type": "integer", "minimum": 0},
    "event": {"type": "integer", "minimum": 0},
    "state": {"type": "object"},
    "patch": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["op", "path"],
        "properties": {
          "op": {"enum": ["add", "remove", "replace"]},
          "path": {"type": "string"},
          "value": {}
        },
        "additionalProperties": false
      }
    },
    "defs": {"type": "array", "items": {"type": "object"}},
    "events": {"type": "array", "items": {"type": "object"}},
    "decision": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": [
            "cap",
            "id",
            "kind",
            "actor",
            "allow",
            "legal_actions",
            "sim",
            "ctx"
          ],
          "properties": {
            "cap": {"type": "string", "minLength": 32, "maxLength": 256},
            "id": {"type": "string", "minLength": 1},
            "kind": {"type": "string", "minLength": 1},
            "actor": {"type": ["string", "null"]},
            "allow": {"type": "array", "items": {"type": "string"}},
            "legal_actions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "action"]
              }
            },
            "sim": {"type": "integer", "enum": [0, 1]},
            "ctx": {"type": "object"}
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "full"}}},
      "then": {
        "required": ["state"],
        "properties": {"base": {"type": "null"}}
      }
    },
    {
      "if": {"properties": {"mode": {"const": "delta"}}},
      "then": {
        "required": ["patch", "rev", "event"],
        "properties": {"base": {"type": "string"}}
      }
    }
  ],
  "additionalProperties": false
}
