{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtg-commander-sim.local/schemas/rule-conformance-review-v1.json",
  "title": "Pinned Comprehensive Rules conformance review overlay v1",
  "type": "object",
  "required": [
    "schema_version",
    "effective_date",
    "source_sha256",
    "family",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "effective_date": {"type": "string", "format": "date"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "family": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "rule_text_sha256",
          "classification",
          "status",
          "assertion_kind",
          "reviewed",
          "implementation_components",
          "executable_test_ids",
          "required_scenarios",
          "covered_scenarios",
          "blockers",
          "notes"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^[0-9]{3}(?:\\.[0-9]+[a-z]?)?$"
          },
          "rule_text_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "classification": {
            "enum": [
              "unclassified",
              "behavioral",
              "definition_only",
              "structural",
              "example",
              "dependency"
            ]
          },
          "status": {
            "enum": [
              "unreviewed",
              "passing",
              "failing",
              "blocked",
              "skipped",
              "definition_only"
            ]
          },
          "assertion_kind": {
            "enum": [
              "inventory_only",
              "executable_engine",
              "static_traceability",
              "unsupported_fail_closed"
            ]
          },
          "reviewed": {"type": "boolean"},
          "implementation_components": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "executable_test_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "required_scenarios": {
            "type": "array",
            "items": {
              "enum": [
                "positive",
                "negative",
                "interaction",
                "multiplayer",
                "replay",
                "hidden_information"
              ]
            },
            "uniqueItems": true
          },
          "covered_scenarios": {
            "type": "array",
            "items": {
              "enum": [
                "positive",
                "negative",
                "interaction",
                "multiplayer",
                "replay",
                "hidden_information"
              ]
            },
            "uniqueItems": true
          },
          "blockers": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "notes": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
