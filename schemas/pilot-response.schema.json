{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtg-commander-sim.local/schemas/pilot-response-v1.json",
  "title": "Provider-neutral pilot response",
  "type": "object",
  "oneOf": [
    {"required": ["action_id"]},
    {"required": ["action"]},
    {"required": ["actions"]}
  ],
  "required": ["plan", "reason"],
  "properties": {
    "action_id": {"type": "string"},
    "action": {"type": "string"},
    "choices": {"type": "object"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["action_id"],
        "properties": {
          "action_id": {"type": "string"},
          "choices": {"type": "object"},
          "future_choices": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "plan": {
      "enum": [
        "MULLIGAN",
        "DEVELOP_MANA",
        "FIX_COLORS",
        "DEVELOP_ENGINE",
        "HOLD_INTERACTION",
        "DISRUPT_LEADER",
        "PROTECT_ENGINE",
        "ASSEMBLE_WIN",
        "PRESSURE_PLAYER",
        "RECOVER",
        "PASS_WITH_YIELD"
      ]
    },
    "reason": {"type": "string", "maxLength": 180},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "yield": {"type": ["string", "null"]},
    "memory_update": {"type": "string", "maxLength": 500}
  },
  "additionalProperties": true
}
