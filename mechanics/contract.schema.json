{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mtg-commander-sim/mechanic-contract-v1.schema.json",
  "title": "Quorune mechanic contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "mechanic_id",
    "official_name",
    "effective_date",
    "source_sha256",
    "rule_references",
    "glossary_references",
    "dependencies",
    "coverage_status",
    "trust_level",
    "behavior",
    "variants",
    "witness_cards",
    "rulings",
    "test_ids",
    "implementation",
    "known_blockers",
    "review_status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_version": {"type": "integer", "minimum": 1},
    "mechanic_id": {"type": "string", "minLength": 1},
    "official_name": {"type": "string", "minLength": 1},
    "effective_date": {"type": "string", "format": "date"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rule_references": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "glossary_references": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "coverage_status": {
      "enum": ["planned", "partial", "implemented", "tested", "trusted"]
    },
    "trust_level": {"enum": ["untrusted", "provisional", "trusted"]},
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zones",
        "objects",
        "events",
        "state_reads",
        "state_writes",
        "costs",
        "timing",
        "targets",
        "choices",
        "hidden_information",
        "apnap",
        "layers",
        "replacement_effects",
        "copy",
        "control_change",
        "zone_change",
        "source_leaves"
      ],
      "properties": {
        "zones": {"$ref": "#/$defs/strings"},
        "objects": {"$ref": "#/$defs/strings"},
        "events": {"$ref": "#/$defs/strings"},
        "state_reads": {"$ref": "#/$defs/strings"},
        "state_writes": {"$ref": "#/$defs/strings"},
        "costs": {"$ref": "#/$defs/strings"},
        "timing": {"$ref": "#/$defs/strings"},
        "targets": {"$ref": "#/$defs/strings"},
        "choices": {"$ref": "#/$defs/strings"},
        "hidden_information": {"$ref": "#/$defs/strings"},
        "apnap": {"$ref": "#/$defs/strings"},
        "layers": {"$ref": "#/$defs/strings"},
        "replacement_effects": {"$ref": "#/$defs/strings"},
        "copy": {"$ref": "#/$defs/strings"},
        "control_change": {"$ref": "#/$defs/strings"},
        "zone_change": {"$ref": "#/$defs/strings"},
        "source_leaves": {"$ref": "#/$defs/strings"}
      }
    },
    "variants": {"$ref": "#/$defs/strings"},
    "witness_cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "oracle_id"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "oracle_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      }
    },
    "rulings": {"$ref": "#/$defs/strings"},
    "test_ids": {"$ref": "#/$defs/strings"},
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "known_blockers": {"$ref": "#/$defs/strings"},
    "review_status": {"enum": ["draft", "reviewed"]}
  },
  "$defs": {
    "strings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
