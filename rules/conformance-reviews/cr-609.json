      ],
      "blockers": [
        "damage events do not universally derive current or last-known source properties from authoritative state",
        "generated shields have no persistent active-effect identity, duration, or used-up state across engine events",
        "the event producer cannot prove that zero prevented or replaced damage preserves every stateful shield"
      ],
      "notes": [
        "A mismatching supplied property does not apply or journal the effect, and a later matching event can use the same immutable primitive.",
        "Unknown condition predicates now fail closed instead of accidentally matching."
      ]
    },
