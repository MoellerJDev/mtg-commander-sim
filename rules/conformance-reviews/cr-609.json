      "blockers": [
        "mana-payment plans do not represent a scoped as-though spending permission",
        "the payment record does not retain authoritative identity and actual type or color for every mana unit spent",
        "cost requirements and payment permissions are not separately modeled for this family"
      ],
      "notes": [
