{
  "schema_version": 2,
  "document_globs": [
    "*.md",
    "coverage/*.md",
    "data/*.md",
    "demo/*.md",
    "docs/**/*.md",
    "mechanics/**/*.md",
    "rules/*.md"
  ],
  "excluded_prefixes": [
    ".agents/skills/",
    ".github/"
  ],
  "required_metadata": [
    "title",
    "status",
    "authoritative_source",
    "verified",
    "audience",
    "maintenance"
  ],
  "statuses": [
    "current",
    "target",
    "historical",
    "generated",
    "ADR"
  ],
  "maintenance_modes": [
    "hand-maintained",
    "generated"
  ],
  "adr_decision_statuses": [
    "proposed",
    "accepted",
    "deprecated",
    "superseded",
    "rejected"
  ],
  "root_document_allowlist": [
    "AGENTS.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "README.md",
    "SECURITY.md"
  ],
  "authoritative_concerns": {
    "architecture-portal": "ARCHITECTURE.md",
    "browser-product": "docs/product/browser.md",
    "codex-arena-adapter": "docs/optional-clients/codex-arena.md",
    "contributor-contract": "CONTRIBUTING.md",
    "game-record": "docs/reference/game-record.md",
    "local-operations": "docs/operations/local-app.md",
    "namespace-migration": "docs/MIGRATING_TO_QUORUNE.md",
    "network-protocol": "docs/reference/protocol.md",
    "optional-provider-contract": "docs/optional-clients/providers.md",
    "oracle-ir": "docs/reference/oracle-ir.md",
    "project-overview": "README.md",
    "rebrand-status": "docs/REBRAND_STATUS.md",
    "rules-assurance": "docs/rules/assurance-model.md"
  },
  "retired_documents": [
    "CLIENT_INTEGRATION.md",
    "CODEX_ARENA.md",
    "GAME_RECORD.md",
    "LLM_PROTOCOL.md",
    "ORACLE_IR.md",
    "OVERNIGHT_HANDOFF.md",
    "PACKAGE_INFO.txt",
    "PILOT_PROVIDERS.md",
    "RULE_CONFORMANCE.md",
    "RULES_COMPLETENESS.md",
    "SEMANTIC_PACKS.md",
    "SERVER_BROWSER.md",
    "TEST_RESULTS.txt",
    "docs/architecture/damage-transactions.md"
  ],
  "historical_allowed_prefixes": [
    "docs/adr/",
    "docs/history/"
  ],
  "historical_allowed_documents": [
    "CHANGELOG.md"
  ],
  "generated_dashboards": {
    "coverage/platform-readiness.md": {
      "source": "coverage/platform-readiness.json",
      "command": ".\\.venv\\Scripts\\python.exe scripts\\update_platform_status.py --write"
    },
    "docs/ARCHITECTURE_DEBT_STATUS.md": {
      "source": "coverage/architecture-audit.json",
      "command": ".\\.venv\\Scripts\\python.exe scripts\\update_architecture_audit.py --write --card-db data\\scryfall-current.sqlite3"
    },
    "docs/COMPILER_COVERAGE_STATUS.md": {
      "source": "coverage/architecture-audit.json",
      "command": ".\\.venv\\Scripts\\python.exe scripts\\update_architecture_audit.py --write --card-db data\\scryfall-current.sqlite3"
    },
    "docs/PLATFORM_IMPLEMENTATION_STATUS.md": {
      "source": "coverage/platform-readiness.json",
      "command": ".\\.venv\\Scripts\\python.exe scripts\\update_platform_status.py --write"
    },
    "docs/RULES_DEPENDENCY_QUEUE.md": {
      "source": "coverage/rules-dependency-queue.json",
      "command": ".\\.venv\\Scripts\\python.exe scripts\\update_rules_scheduler.py --write"
    },
    "docs/reference/protocol-inventory.md": {
      "source": "coverage/protocol-inventory.json",
      "command": ".\\.venv\\Scripts\\python.exe scripts\\update_protocol_reference.py --write"
    }
  },
  "metric_authorities": [
    "coverage/architecture-audit.json",
    "coverage/mechanics-coverage.json",
    "coverage/oracle-coverage.json",
    "coverage/oracle-coverage-commander.json",
    "coverage/platform-readiness.json",
    "coverage/reusable-piece-matrix.json.gz",
    "coverage/reusable-piece-delta.json",
    "coverage/complex-card-composition.json",
    "coverage/program-baseline.json",
    "coverage/rules-conformance.json",
    "coverage/rules-coverage.json",
    "coverage/rules-delta.json"
  ],
  "stale_claim_patterns": [
    {
      "name": "test or case count",
      "pattern": "(?i)(?:\\b[0-9][0-9,]*(?:\\.[0-9]+)?\\s+(?:generated\\s+|deterministic\\s+|conformance\\s+)?(?:tests?|cases?)\\s+(?:pass|passed|passing|discovered|remain|are|were)|(?:tests?|cases?)\\s*(?:discovered|passed|passing|total)?\\s*[:=]\\s*[0-9][0-9,]*)"
    },
    {
      "name": "compiler coverage count",
      "pattern": "(?i)(?:oracle ids?|material residuals?|exact|partially lowerable|unresolved|trusted mechanics?|trusted rules?|blocked|unreviewed)\\s*(?:count|cases?)?\\s*[:=]\\s*[0-9][0-9,]*"
    },
    {
      "name": "material residual total",
      "pattern": "(?i)\\b[0-9][0-9,]*\\s+material residuals?\\b"
    },
    {
      "name": "grouped numerical metric",
      "pattern": "(?i)\\b[0-9]{1,3}(?:,[0-9]{3})+\\b\\s+(?:tests?|cases?|rules?|mechanics?|oracle ids?|faces?|material residuals?|tokens?|characters?|commands?|journeys?)",
      "excluded_documents": [
        "AGENTS.md"
      ]
    }
  ]
}
